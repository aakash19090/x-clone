{
    "editor.formatOnSave": true,
    "semi": true,
    "proseWrap": "always",
    "printWidth": 120,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": true,
    "trailingComma": "all",
    "importOrderTypeScriptVersion": "5.0.0",
    "tailwindFunctions": ["clsx"],
    "tailwindConfig": "./tailwind.config.mjs"
}
